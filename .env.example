# Public site
DOMAIN=monitor.example.com
PUBLIC_URL=https://monitor.example.com
API_BASE_URL=https://monitor.example.com/api
APP_ENV=production
# Comma-separated browser origins used for local frontend development. Keep empty in production.
CORS_ORIGINS=

# Application authentication
# Replace with a long random value before deployment.
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-deployment

# PostgreSQL
POSTGRES_USER=threads_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=threads_monitor
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Threads API and webhook credentials. THREADS_APP_ID is the Threads App ID
# shown in Meta's Threads app settings; it is distinct from META_APP_ID.
META_APP_ID=
META_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_VERIFY_TOKEN=replace-with-a-random-webhook-verify-token
THREADS_API_BASE_URL=https://graph.threads.net
THREADS_COLLECTION_ENABLED=true
THREADS_POLL_INTERVAL_MINUTES=10
THREADS_DAILY_CALL_LIMIT=2200
THREADS_TOKEN_REFRESH_INTERVAL_DAYS=7

# Optional OpenRouter API key for Jev relevance filtering. It can also be saved in Settings → Threads.
OPENROUTER_API_KEY=

# WhatsApp bridge
WHATSAPP_BRIDGE_URL=http://whatsapp-bridge:8080
WHATSAPP_BRIDGE_PORT=8080
WHATSAPP_RECIPIENTS=

# SMTP notifications (optional; can also be configured in the app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@monitor.example.com
# TLS uses implicit SSL on port 465 and STARTTLS on port 587.
SMTP_USE_TLS=true
EMAIL_RECIPIENTS=
